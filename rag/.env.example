# LiveKit Cloud (https://cloud.livekit.io) — also bills the STT + TTS via LiveKit Inference
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# https://www.synthesia.io/features/avatars/interactive-avatars
SYNTHESIA_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional Quail Voice Focus — helps in noisy environments (see README).
# Disabled by default; install requirements-quail.txt. Uses LiveKit Cloud billing.
QUAIL_ENABLED=false

# --- Knowledge base source ---
# "wikipedia" (default): public Wikipedia API — no key, any topic, runs out of the box.
# "bedrock": your own AWS Bedrock managed KB (fill in the AWS section below).
KB_SOURCE=wikipedia

# --- AWS Bedrock (only needed when KB_SOURCE=bedrock; uncomment to use) ---
# The agent calls bedrock-agent-runtime:Retrieve. Provide credentials EITHER as
# keys here, OR via an AWS profile / SSO (AWS_PROFILE). AWS_SESSION_TOKEN is only
# for temporary / SSO credentials, which expire every few hours and need refreshing.
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=your-profile

# Your Bedrock managed knowledge base id — REQUIRED when KB_SOURCE=bedrock.
# See "Grounding your own corpus with Bedrock" in the README to build one.
# BEDROCK_KB_ID=

# --- Optional overrides (sensible defaults in agent.py) ---
# PERSONA_NAME=Kenji          # defaults to "Kenji" (wikipedia) / "Aristotle" (bedrock)
# RETRIEVAL_TOP_N=5
# Wikimedia asks anonymous callers to identify themselves — fine to leave the generic
# default for the demo, but set a real app name + contact before any real volume:
# WIKI_USER_AGENT=your-app/1.0 (you@example.com)
# SYNTHESIA_AVATAR_ID=7572faa9-15da-400d-8227-ef1ab8932523   # Kenji (Aristotle demo face)
# CARTESIA_VOICE_ID=b134c304-d095-4d2b-a77a-914f5e8e84e7      # Sterling — Monarch
