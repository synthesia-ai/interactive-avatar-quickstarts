# LiveKit Cloud (https://cloud.livekit.io) — also bills the STT + TTS via LiveKit Inference
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# https://www.synthesia.io/features/avatars/interactive-avatars
SYNTHESIA_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional Quail Voice Focus — helps in noisy environments (see README).
# Disabled by default; requires requirements-quail.txt, an SDK key, and a model.
QUAIL_ENABLED=false
AIC_SDK_KEY=
QUAIL_MODEL_PATH=

# --- Optional overrides (sensible defaults in agent.py) ---
# SYNTHESIA_AVATAR_ID=4b638067-6319-46e1-b634-371a4bdfceb9   # Mei
# CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4      # Skylar
