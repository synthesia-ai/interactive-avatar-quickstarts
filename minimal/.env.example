# LiveKit Cloud (https://cloud.livekit.io) — also bills the STT + TTS via LiveKit Inference
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# https://www.synthesia.io/features/avatars/interactive-avatars
SYNTHESIA_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional Quail Voice Focus — helps in noisy environments (see README).
# Disabled by default; requires requirements-quail.txt and an SDK key.
QUAIL_ENABLED=false
AIC_SDK_KEY=
# Optional: leave blank to download/cache Quail 2.2 L; checks the online manifest at startup.
# Set a local model path to skip both the download and the manifest check.
QUAIL_MODEL_PATH=
